rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Footage for one take. Reads are open for the same reason a share document's are: the
    // download URL carries an unguessable token, and that token is the whole guard.
    match /takes/{uid}/{takeId} {
      allow read: if true;

      // The size cap is the one line here that bounds what this project can ever cost.
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.size <= 200 * 1024 * 1024
                            && request.resource.contentType.matches('video/.*');

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // The song a collaborative project is built on. Storage rules cannot read Firestore, so
    // membership is unenforceable here: the guard is the same one takes rely on, an
    // unguessable download token that only the project document hands out. The key segment
    // is random rather than the project id, so knowing a project id reveals no path.
    match /songs/{uid}/{key} {
      allow read: if true;

      // 100MB clears a 20-minute medley at 320kbps with room to spare, and bounds the bill.
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.size <= 100 * 1024 * 1024
                            && request.resource.contentType.matches('audio/.*');

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{rest=**} {
      allow read, write: if false;
    }
  }
}
